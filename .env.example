# Copy to .env and fill in real values. Never commit .env.

# --- API (required; app fails fast if missing) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/dropme
REDIS_URL=redis://redis:6379/0
API_KEY=

# --- Postgres container ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=dropme

# --- Build identity (wired to /version and dropme_build_info) ---
VERSION=0.0.0-dev
GIT_SHA=
BUILT_AT=

# --- Grafana (local only) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# --- Logging ---
LOG_LEVEL=INFO
