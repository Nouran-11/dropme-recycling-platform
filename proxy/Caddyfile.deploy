# Deployment gateway: a real hostname (<eip>.sslip.io) so Caddy's default
# auto_https provisions a Let's Encrypt certificate. SITE_ADDRESS is injected by
# the instance's .env. Do not use this file locally — it needs a public name.
{$SITE_ADDRESS} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'"
	}
}
