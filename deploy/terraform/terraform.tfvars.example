# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# No secrets belong here — the instance generates them itself.

my_ip    = "203.0.113.4/32" # your public IP as a /32, for SSH
key_name = "my-keypair"     # an existing EC2 key pair name in the region

# Optional overrides:
# region        = "eu-north-1"
# instance_type = "t3.medium"
# repo_url      = "https://github.com/Nouran-11/dropme-recycling-platform.git"
